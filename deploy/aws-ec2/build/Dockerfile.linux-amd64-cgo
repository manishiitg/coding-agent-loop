# Cross-compiles the Video Studio agent for linux/amd64 WITH cgo.
#
# Why this exists: the agent's streaming speech-to-text (pkg/voicestt) links
# sherpa-onnx's prebuilt native libraries, which need CGO_ENABLED=1. A plain
# `CGO_ENABLED=0 GOOS=linux go build` from the deployer's Mac compiles the
# non-CGO stub instead, and the mic control then answers 503 on the server.
# A Mac has no linux/amd64 C toolchain, so build-linux-agent.sh builds the agent
# inside this image: a native arm64 Go image plus the Debian x86-64 cross gcc,
# which is far faster than emulating an amd64 container.
#
# Build once (build-linux-agent.sh does this when the image is missing):
#   docker build -t video-studio-linux-amd64-builder -f deploy/aws-ec2/build/Dockerfile.linux-amd64-cgo deploy/aws-ec2/build
FROM golang:1.26-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu g++-x86-64-linux-gnu libc6-dev-amd64-cross \
 && rm -rf /var/lib/apt/lists/*
ENV CC=x86_64-linux-gnu-gcc CXX=x86_64-linux-gnu-g++ CGO_ENABLED=1 GOOS=linux GOARCH=amd64
