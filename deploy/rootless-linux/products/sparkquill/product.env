# SparkQuill deployment config, read by deploy/rootless-linux/*.sh on both the
# triggering machine and the remote host. See deploy/rootless-linux/README.md.

PRODUCT=sparkquill
HOST_IP="${HOST_IP:-116.202.210.102}"
SSH_PORT="${SSH_PORT:-2299}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/id_ed25519}"
DOMAIN="sparkquill.agentworkshq.com"

AGENT_PORT=23000
WORKSPACE_PORT=23001
GATEWAY_ADDR="127.0.0.1:23080"

# Fixed single-product deployment: one workspace (Chats/SparkQuill), one
# locked provider/model -- not a generic multi-surface AgentWorks instance.
AGENT_PRODUCTS="sparkquill"
AGENT_PROVIDER="codex-cli"
AGENT_MODEL="gpt-6-astra"
AGENT_MAX_TURNS=100

# Coding-agent CLIs this deployment needs (product.yaml's provider_options:
# codex-cli, claude-code -- no cursor-cli/pi-cli/muse).
CLI_TOOLS=(claude codex)

# No product-owned Node pin -- use whatever Node is already on the host PATH
# (confirmed present: v22.22.1 at /usr/bin/node).
PIN_NODE_VERSION=""

# SparkQuill has no admin-only / multi-surface product gating and no
# Workflow/playbook catalog -- it is a fixed single-workspace product, not a
# generic AgentWorks instance like confida.
COPY_PLAYBOOKS=false
RUN_WORKFLOW_BUILDER_MIGRATION=false

# Not yet configured on this deployment (no PUBLIC_URL in /srv/sparkquill/.env
# today, so no MCP OAuth callback depends on it yet). Leave unset so the
# deploy skips the check instead of failing on a pre-existing gap; set this
# once PUBLIC_URL is added to the remote .env for OAuth-based MCP servers.
EXPECTED_PUBLIC_URL=""

# Extra systemd Environment= lines applied to both sparkquill-agent and
# sparkquill-workspace via one managed drop-in. Everything already in
# /srv/sparkquill/.env (WORKSPACE_DOCS_PATH, AGENT_BROWSER_SHARED_PROFILE,
# SANDBOX_EXTRA_SYSTEM_PATHS, AGENT_BROWSER_NAMESPACE, ...) stays there,
# untouched -- this only adds/overrides what the deploy itself must guarantee.
EXTRA_ENV=(
  "AGENT_BROWSER_CDP_ENABLED=false"
)
