{
  "contract_version": "engineering-source-map/v1",
  "revision": 1,
  "status": "example_only",
  "scope": {
    "organization": "example-org",
    "teams": ["example-team"],
    "repositories": ["example-org/example-repository"],
    "services": ["example-service"],
    "environments": ["staging", "production"],
    "timezone": "customer-defined"
  },
  "sources": [
    {
      "id": "scm-example",
      "type": "source_control",
      "access": "read_only",
      "entities": ["repository", "pull_request", "review", "commit", "check"],
      "history_start": null,
      "refresh": "customer-defined"
    },
    {
      "id": "issues-example",
      "type": "issue_tracker",
      "access": "read_only",
      "entities": ["project", "work_item", "state_transition"],
      "history_start": null,
      "refresh": "customer-defined"
    }
  ],
  "mappings": {
    "work_item_to_pull_request": "source-native links or reviewed explicit references",
    "commit_to_build": "source-native SHA mapping",
    "build_to_deployment": "deployment-system build identity",
    "people": "approved directory mapping only"
  },
  "restricted_fields": [],
  "retention": "customer-defined"
}
