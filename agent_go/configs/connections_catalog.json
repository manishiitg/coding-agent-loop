    {
      "id": "github",
      "server_name": "github",
      "name": "GitHub",
      "tagline": "Repos, issues, and pull requests",
      "category": "development",
      "icon": "github",
      "brand_color": "#181717",
      "status": "available",
      "auth": "oauth_app",
      "url": "https://api.githubcopilot.com/mcp/",
      "docs_url": "https://docs.github.com/en/copilot/how-tos/context/use-mcp/",
      "auth_url": "https://github.com/login/oauth/authorize",
      "token_url": "https://github.com/login/oauth/access_token",
      "client_id_env": "GITHUB_OAUTH_CLIENT_ID",
      "client_secret_env": "GITHUB_OAUTH_CLIENT_SECRET",
      "scopes": [
        "repo",
        "read:org",
        "read:user",
        "user:email"
      ],
      "capabilities": [
        "Search code and repositories",
        "Read and comment on issues",
        "Read pull requests and diffs",
        "Create issues and pull requests"
      ],
      "sensitive_actions": [
        "Create issues, comments, or pull requests"
      ],
      "setup_hint": "GitHub does not register applications automatically. Create an OAuth App in GitHub developer settings, then set GITHUB_OAUTH_CLIENT_ID and GITHUB_OAUTH_CLIENT_SECRET on the server."
    },
