# Environment Variables for MCP Agent
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# AWS Bedrock (Claude models)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# OpenAI (GPT models)
OPENAI_API_KEY=your_openai_api_key

# Anthropic (Claude models - direct API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Pi CLI (defaults to Gemini-backed routes; falls back to GEMINI_API_KEY/GOOGLE_API_KEY)
PI_API_KEY=your_pi_or_gemini_api_key

# OpenRouter (Access to multiple models)
OPEN_ROUTER_API_KEY=your_openrouter_api_key

# =============================================================================
# LLM CONFIGURATION (No Hardcoded Values)
# =============================================================================

# Primary LLM Configuration
AGENT_PROVIDER=openrouter
AGENT_MODEL=x-ai/grok-code-fast-1

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-...

# Bedrock Configuration
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-1

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# =============================================================================
# Model Configuration (Optional - uses defaults if not set)
# =============================================================================

# Bedrock default model
BEDROCK_PRIMARY_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# OpenAI default model
OPENAI_PRIMARY_MODEL=gpt-4.1-mini

# Anthropic default model
ANTHROPIC_PRIMARY_MODEL=claude-3-5-sonnet-20241022

# OpenRouter default model
OPENROUTER_PRIMARY_MODEL=moonshotai/kimi-k2

# =============================================================================




# =============================================================================
# Observability (Optional)
# =============================================================================

# Langfuse tracing
TRACING_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_DEBUG=true

# Console tracing (fallback)
# TRACING_PROVIDER=console

# No tracing
# TRACING_PROVIDER=noop

# =============================================================================
# Agent Configuration (Optional)
# =============================================================================

# Agent provider (bedrock, openai, anthropic, openrouter)
AGENT_PROVIDER=bedrock

# Agent model ID (uses provider default if not set)
AGENT_MODEL=

# Temperature for LLM responses
TEMPERATURE=0.7

# Maximum conversation turns
MAX_TURNS=500

# =============================================================================
# Cache Configuration (Optional)
# =============================================================================

# MCP Cache TTL in minutes (default: 10080 = 7 days)
MCP_CACHE_TTL_MINUTES=10080

# MCP Cache directory (default: agent_go/cache)
MCP_CACHE_DIR=

# =============================================================================
# Testing Configuration (Optional)
# =============================================================================

# Test timeout duration
TEST_TIMEOUT=5m

# Test log level
TEST_LOG_LEVEL=info

# Test log format
TEST_LOG_FORMAT=text

# =============================================================================
# Workspace Configuration (Optional)
# =============================================================================

# =============================================================================
# Multi-User Authentication (Optional)
# Copy real values into .env (gitignored, never committed). Placeholders only here.
# See docs/core/multi_user_authentication.md.
# =============================================================================

# Set to true to require login (JWT). Default single-user mode needs none of this.
MULTI_USER_MODE=false

# JWT signing secret. Required in multi-user mode; generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-value

# Enabled login providers (comma-separated): simple, cognito, supabase, supabase-google
AUTH_PROVIDERS=simple

# Plain username/password logins, bootstrapped into config/users.json on first start
# (passwords are hashed at import; the env var can be removed afterwards).
AUTH_USERS=admin:change-me-min-8-chars

# Usernames or emails that are admins (applied to matching accounts, incl. first SSO login)
ADMIN_USERS=admin

# Supabase Auth (email/password via "supabase", Google sign-in via "supabase-google")
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx-your-anon-public-key

# AWS Cognito (OAuth via "cognito")
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
