[Unit]
Description=Video Studio cookie-auth gateway (user service)
After=video-studio-agent.service video-studio-workspace.service
ConditionPathIsMountPoint=/data/video-studio

[Service]
EnvironmentFile=%h/video-studio/.env
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=FRONTEND_DIR=%h/video-studio/current/frontend
WorkingDirectory=%h/video-studio/current
ExecStart=%h/video-studio/current/bin/video-studio-gateway
StandardOutput=append:%h/video-studio/logs/gateway.log
StandardError=append:%h/video-studio/logs/gateway.log
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
