# === Required ===
# Agents run only on coding-agent CLIs. Authenticate the CLI you use, e.g.:
CLAUDE_CODE_OAUTH_TOKEN=

# === Database ===
# SQLite (default, no external DB needed):
DB_TYPE=sqlite
# Postgres (optional):
# DB_TYPE=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# === LLM Providers ===
LLM_CONFIG_LOCKED=false
# Coding-agent CLIs only: claude-code, codex-cli, cursor-cli, pi-cli, muse-cli
SUPPORTED_LLM_PROVIDERS=claude-code

# === Published Models (shown in UI) ===
DEFAULT_PUBLISHED_LLMS='[{"id":"claude-code-sonnet-5","name":"Claude Code (Sonnet 5)","provider":"claude-code","model_id":"claude-sonnet-5"}]'

# === Optional: Tracing ===
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# TRACING_PROVIDER=langfuse

# === Optional: Agent config ===
MAX_TURNS=500

# === Optional: Global secrets (injected into agent queries) ===
# GLOBAL_SECRET_GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
