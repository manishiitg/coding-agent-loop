# Environment files - NEVER commit these!
.env
.env.*
!.env.example
.env.local
.env.development
.env.production
.env.test
.env.staging

agent_go/configs/mcp_server_actual.json

*.log
logs/
**/logs/

bin/*

# Additional security patterns
*.key
*.pem
*.p12
*.pfx
*.crt
*.cert
*.pwd
*secret*
*credential*
*password*
!scripts/*secret*.sh
!frontend/src/**/secret*
!frontend/src/**/*ecret*
!frontend/src/api/secrets.ts
!agent_go/cmd/server/secrets_tools.go
!agent_go/cmd/server/secrets_routes.go
!agent_go/pkg/orchestrator/**/secrets_*.go
!agent_go/cmd/server/guidance/templates/system/secret-management.md
# PLAT-272 shared workflow-secret store: source and its test, no secret values.
!agent_go/cmd/server/workflow_shared_secrets.go
!agent_go/cmd/server/workflow_shared_secrets_test.go
!agent_go/pkg/chathistory/shared_secrets.go
# Gmail OAuth client_secret.json resolution test: source only, no secret values.
!agent_go/cmd/server/services/gmail_oauth_client_secret_test.go
# The *credential* rule above is meant for credential FILES, but it also
# swallows source that merely has "Credential" in its name. These two are
# ordinary UI source (a form field and a masking helper) holding no secret
# value, and they were silently never committed: the build passed locally
# where the untracked files exist and failed in CI where they don't. Same
# class of problem the secret* negations above already had to solve.
!frontend/src/components/WorkflowProviderCredentialField.tsx
!frontend/src/utils/maskCredentialPreview.ts
# Same again for *password*: a change-your-own-password form, no password in it.
!frontend/src/components/topbar/ChangePasswordDialog.tsx

